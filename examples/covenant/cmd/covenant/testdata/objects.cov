// Trait objects, and data whose shape is not known when the program is written.

use io

trait Area {
    fn area(self) -> Float
}

struct Circle { radius: Float }
struct Rect { w: Float, h: Float }

impl Area for Circle {
    fn area(self) -> Float {
        return 3.0 * self.radius * self.radius
    }
}

impl Area for Rect {
    fn area(self) -> Float {
        return self.w * self.h
    }
}

fn describe(d: Data) -> Text {
    return match d {
        Null => "nothing"
        Bool(value) => value.to_text()
        Int(value) => "the number " + value.to_text()
        Float(value) => "the float " + value.to_text()
        Text(value) => "the text " + value
        List(items) => "a list of " + items.length().to_text()
        Map(entries) => "a map of " + entries.length().to_text()
    }
}

fn report(doc: Data) with io::print {
    io::print(doc.to_json())
    io::print(describe(doc))
}

fn main() with io::print -> Int {
    let shapes = [Circle(radius: 1.0) as dyn Area, Rect(w: 2.0, h: 3.0) as dyn Area]
    for shape in shapes {
        io::print(shape.area().to_text())
    }

    match Data::from_json("{\"name\": \"covenant\", \"tags\": [1, 2.5, null]}") {
        Ok(doc) => report(doc)
        Err(_) => io::print("not json")
    }

    return shapes.length()
}
