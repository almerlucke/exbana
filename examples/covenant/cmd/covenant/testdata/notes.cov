use fs

// Reads a note from a file.
// It gives an error if there is no such file, or it is not allowed.
pub fn read_note(path: Text) with fs::read -> Result<Text, fs::IoError> {
    return fs::read(path)
}

// Adds two numbers.
pub fn add(a: Int, b: Int) -> Int {
    example add(1, 2) == 3
    return a + b
}

pub fn shout(text: Text) -> Text {
    return text.upper() + "!"
}

pub fn identity<T>(x: T) -> T {
    return x
}

fn hidden() -> Int {
    return 1
}
